# Copy to .env.local for local development.
# Leave VITE_FIREBASE_CONFIG empty to run the app in local Demo Mode (no backend needed).

# Firebase console → Project settings → General → Your apps → SDK setup and configuration → Config
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","storageBucket":"your-project.firebasestorage.app","messagingSenderId":"...","appId":"..."}

# Must match REGION in functions/src/common.ts
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Use the local Firebase emulators (npm run emulators) instead of the real project
VITE_USE_FIREBASE_EMULATORS=false
